# ============================================================
# Motorflash Ibérica — variables de entorno
# ============================================================
# Copia este archivo a `.env` y completa los valores.
# En Vercel se configuran desde Project Settings → Environment Variables.
# ============================================================

# --- Payload ---
# Secreto usado para firmar tokens JWT. Genera uno largo:
#   openssl rand -base64 32
PAYLOAD_SECRET=change-this-to-a-long-random-string

# --- Base de datos ---
# Dev local (SQLite, no necesita instalación):
DATABASE_URI=file:./motorflash.db
#
# Producción Vercel (Postgres). Usa la "DATABASE_URL" que te da
# Vercel Postgres / Neon (la versión "pooled" para serverless):
# DATABASE_URI=postgresql://user:pass@host.region.aws.neon.tech/dbname?sslmode=require

# --- URL pública (necesaria para emails y CMS) ---
NEXT_PUBLIC_SERVER_URL=http://localhost:3100

# --- SMTP (Mailpit en dev, proveedor real en prod) ---
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
MAILER_FROM=no-reply@motorflash.com

# --- A dónde enviar las cotizaciones recibidas ---
COMMERCIAL_EMAIL=comercial@motorflash.com
